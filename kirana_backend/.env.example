# Copy this file to `.env` for local development (never commit the real
# `.env` -- it's in .gitignore). In production (Render), set these in the
# service's Environment tab instead of a file.

# Local dev default: a SQLite file, so you can run the API with zero
# setup. In production this MUST be your Aiven Postgres connection
# string, e.g.:
#   postgres://avnadmin:PASSWORD@your-service.aivencloud.com:12345/defaultdb?sslmode=require
DATABASE_URL=sqlite:///./dev.db

# Any random long string -- used to sign login tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-secret-change-me

# Admin login (matches the Flutter app's ADMIN_ID / ADMIN_PASSWORD
# --dart-define values -- keep both sides in sync).
ADMIN_ID=
ADMIN_PASSWORD=

# textbee.dev credentials for real OTP SMS. Leave blank to disable real
# sending -- /auth/otp/send will then return the code directly in the
# response's `debug_otp` field for local testing.
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=

# Comma-separated allowed origins for CORS. "*" is fine for a mobile app.
CORS_ALLOW_ORIGINS=*
