# Copy this file to `.env` for local development (never commit the real
# `.env` -- it's in .gitignore). In production (Render), set these in the
# service's Environment tab instead of a file.

# Local dev default: a SQLite file, so you can run the API with zero
# setup. In production this MUST be your Aiven Postgres connection
# string, e.g.:
#   postgres://avnadmin:PASSWORD@your-service.aivencloud.com:12345/defaultdb?sslmode=require
DATABASE_URL=sqlite:///./dev.db

# Any random long string -- used to sign login tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-secret-change-me

# Admin login credentials, checked by POST /auth/admin/login. Set these
# and log in from the app's Admin screen with the same id/password.
ADMIN_ID=
ADMIN_PASSWORD=

# textbee.dev credentials for real OTP SMS. Leave blank to disable real
# sending -- /auth/otp/send will then return the code directly in the
# response's `debug_otp` field for local testing.
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=

# Comma-separated allowed origins for CORS. "*" is fine for a mobile app.
CORS_ALLOW_ORIGINS=*

# White-label APK generation ("Generate My App" on the shopkeeper
# dashboard -- see routers/deploy.py and
# .github/workflows/build_apk.yml). Leave GITHUB_TOKEN blank to disable
# the feature; everything else keeps working without it.
#   GITHUB_TOKEN: a fine-grained PAT (or GitHub App token) with
#     "Actions: read and write" + "Contents: read and write" on GITHUB_REPO.
#   GITHUB_REPO: "owner/repo", e.g. "sharma-kirana/kirana-mandi".
GITHUB_TOKEN=
GITHUB_REPO=
GITHUB_WORKFLOW_FILE=build_apk.yml
GITHUB_WORKFLOW_REF=main
